# ---- LLM used for clip selection, hooks, titles, translation ----
# provider "gemini" (native) or "openai" (any OpenAI-compatible endpoint)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# For LLM_PROVIDER=openai, e.g. OpenAI, OpenRouter, Groq, DeepSeek, Ollama, LM Studio, vLLM:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1

# ---- optional features ----
# PEXELS_API_KEY=               # AI B-roll (--broll), free key from pexels.com/api
# YOUTUBE_CLIENT_SECRETS=client_secret.json   # publishing: OAuth *desktop* client JSON
# TTS_VOICE=Kore               # AI dubbing voice (Gemini TTS)

# ---- transcription ----
WHISPER_MODEL=large-v3-turbo   # use "small" or "base" on CPU-only machines
WHISPER_DEVICE=auto            # auto | cuda | cpu

# ---- rendering ----
# ENCODER=auto                 # auto picks NVENC when it works, else libx264
RENDER_WORKERS=2

# ---- web service ----
# API_TOKEN=change-me          # required to bind to anything other than localhost
# MAX_UPLOAD_MB=2048
